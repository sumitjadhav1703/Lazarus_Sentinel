{
  "$defs": {
    "ReferenceUsage": {
      "additionalProperties": false,
      "properties": {
        "calls": {
          "const": 1,
          "title": "Calls",
          "type": "integer"
        },
        "estimated_micro_usd": {
          "minimum": 0,
          "title": "Estimated Micro Usd",
          "type": "integer"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "searches": {
          "maximum": 3,
          "minimum": 0,
          "title": "Searches",
          "type": "integer"
        }
      },
      "required": [
        "calls",
        "input_tokens",
        "output_tokens",
        "searches",
        "estimated_micro_usd"
      ],
      "title": "ReferenceUsage",
      "type": "object"
    },
    "WeaknessCitation": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "pattern": "^https://[^\\s]{1,500}$",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url",
        "title"
      ],
      "title": "WeaknessCitation",
      "type": "object"
    },
    "WeaknessReferences": {
      "additionalProperties": false,
      "properties": {
        "citations": {
          "items": {
            "$ref": "#/$defs/WeaknessCitation"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "display_provenance": {
          "const": "recorded",
          "title": "Display Provenance",
          "type": "string"
        },
        "generation": {
          "enum": [
            "mock",
            "live"
          ],
          "title": "Generation",
          "type": "string"
        },
        "model": {
          "enum": [
            "deterministic-mock-v1",
            "muse-spark-1.3"
          ],
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "enum": [
            "mock",
            "meta"
          ],
          "title": "Provider",
          "type": "string"
        },
        "reference_id": {
          "title": "Reference Id",
          "type": "string"
        },
        "references_version": {
          "const": "0.1.0",
          "title": "References Version",
          "type": "string"
        },
        "request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "review_status": {
          "const": "UNREVIEWED",
          "title": "Review Status",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "summary": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/ReferenceUsage"
        }
      },
      "required": [
        "references_version",
        "reference_id",
        "rule_id",
        "request_sha256",
        "provider",
        "model",
        "generation",
        "display_provenance",
        "review_status",
        "created_at",
        "summary",
        "citations",
        "usage"
      ],
      "title": "WeaknessReferences",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "references": {
      "items": {
        "$ref": "#/$defs/WeaknessReferences"
      },
      "maxItems": 1,
      "minItems": 1,
      "title": "References",
      "type": "array"
    },
    "references_version": {
      "const": "0.1.0",
      "title": "References Version",
      "type": "string"
    }
  },
  "required": [
    "references_version",
    "references"
  ],
  "title": "ReferencesEnvelope",
  "type": "object"
}
